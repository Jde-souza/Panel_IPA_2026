{
  "name": "panel-ipa-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "extract:news": "node extract_news.js",
    "extract:inasistencias": "node extract_inasistencias.js",
    "extract:horarios": "node extract_horarios.js",
    "update:all": "npm run extract:news && npm run extract:inasistencias && npm run extract:horarios"
  },
  "private": true,
  "packageManager": "npm@10.2.4",
  "dependencies": {
    "@angular/common": "^21.2.0",
